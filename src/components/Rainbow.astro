---
// Arco-íris da marca. As cores vêm de variáveis CSS para cada seção poder adaptar.
interface Props {
  class?: string;
  a1?: string; a2?: string; a3?: string; a4?: string; heart?: string;
}
const {
  class: className = '',
  a1 = 'var(--color-orange)',
  a2 = 'var(--color-rose)',
  a3 = 'var(--color-peach)',
  a4 = 'var(--color-sage)',
  heart = 'var(--color-orange)',
} = Astro.props;
---
<svg class={className} viewBox="0 0 400 215" aria-hidden="true" focusable="false">
  <path d="M42 200A158 158 0 0 1 358 200" fill="none" stroke={a1} stroke-width="26" stroke-linecap="round" />
  <path d="M74 200A126 126 0 0 1 326 200" fill="none" stroke={a2} stroke-width="26" stroke-linecap="round" />
  <path d="M106 200A94 94 0 0 1 294 200" fill="none" stroke={a3} stroke-width="26" stroke-linecap="round" />
  <path d="M138 200A62 62 0 0 1 262 200" fill="none" stroke={a4} stroke-width="26" stroke-linecap="round" />
  <path d="M200 192c-18-12-28-20-28-32 0-9 7-15 15-15 6 0 10 3 13 8 3-5 7-8 13-8 8 0 15 6 15 15 0 12-10 20-28 32z" fill={heart} transform="translate(200 175) scale(.62) translate(-200 -175)" />
</svg>
