---
import { Image } from 'astro:assets';
import QuoteButton from './QuoteButton.astro';
import heroArco from '../assets/img/hero-arco.jpg';
---
<section id="topo" class="pt-6">
  <div class="wrap grid items-end gap-9 md:min-h-[calc(100dvh-96px)] md:grid-cols-2 md:gap-16">
    <div class="pt-3 md:self-center md:pt-0 md:pb-14">
      <h1 class="mb-6 text-[2.6rem] font-semibold md:text-[clamp(2.5rem,4.2vw,3.8rem)]">
        Festas que viram lembranças felizes.
      </h1>
      <p class="text-ink-soft mb-9 max-w-[30em] text-[1.1rem] md:text-[1.25rem]">
        Decoração, kits pegue e monte, algodão-doce e pipoca para animar a festa do seu pequeno em Igaratá e região.
      </p>
      <QuoteButton />
    </div>

    <!-- Porta-arco-íris: ecoa o arco da logo -->
    <div class="w-full md:max-w-[600px] md:justify-self-end">
      <div data-ring class="bg-orange rounded-t-full px-[11px] pt-[11px] md:px-4 md:pt-4">
        <div data-ring class="bg-rose rounded-t-full px-[11px] pt-[11px] md:px-4 md:pt-4">
          <div data-ring class="bg-peach rounded-t-full px-[11px] pt-[11px] md:px-4 md:pt-4">
            <div data-ring class="bg-sage rounded-t-full px-[11px] pt-[11px] md:px-4 md:pt-4">
              <Image
                data-ring-img
                src={heroArco}
                alt="Arco de balões em tons pastel na entrada de uma festa infantil"
                widths={[480, 720, 960]}
                sizes="(min-width: 768px) 560px, 90vw"
                loading="eager"
                fetchpriority="high"
                class="block aspect-[3/4] h-auto w-full rounded-t-full object-cover"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
