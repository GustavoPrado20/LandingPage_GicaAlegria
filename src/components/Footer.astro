---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { site, whatsappLink } from '../config/site';
import logoNome from '../assets/img/logo-nome.png';
---
<footer class="py-12 md:pb-14">
  <div class="wrap flex flex-col items-start gap-8 md:flex-row md:flex-wrap md:items-center md:justify-between">
    <Image src={logoNome} alt="Gica Alegria, festa infantil" height={112} class="h-14 w-auto" />
    <ul class="flex list-none gap-6 p-0 text-base font-semibold md:gap-[30px]">
      <li><a class="text-ink-soft hover:text-orange-deep inline-flex items-center gap-2 no-underline" href={site.instagram} target="_blank" rel="noopener"><Icon name="instagram-logo" />Instagram</a></li>
      <li><a class="text-ink-soft hover:text-orange-deep inline-flex items-center gap-2 no-underline" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp-logo" />WhatsApp</a></li>
    </ul>
    <small class="text-ink-soft w-full text-sm">{site.cities[0]}, {site.region} e região. Site por GP Softworks.</small>
  </div>
</footer>
