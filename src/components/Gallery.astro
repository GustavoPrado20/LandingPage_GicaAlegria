---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { site } from '../config/site';
import dino from '../assets/img/festa-dino.jpg';
import leao from '../assets/img/festa-leao.jpg';
import arcoIris from '../assets/img/festa-arco-iris.jpg';

// As fotos mantêm a proporção original (sem corte). Cada linha divide o espaço
// na proporção das imagens para que fiquem com a mesma altura.
const img = 'block h-auto w-full rounded-card';
---
<section id="galeria" class="section bg-cream-2">
  <div class="wrap">
    <div class="mb-9 max-w-[780px] md:mb-14">
      <h2 class="section-title mb-4">Festas que já montamos.</h2>
      <p class="text-ink-soft">Alguns momentos felizes que ajudamos a criar.</p>
    </div>

    <div class="grid gap-3.5 md:gap-6" data-gallery>
      <div class="flex flex-col gap-3.5 md:flex-row md:gap-6">
        <div class="md:flex-[0.75]"><Image src={dino} alt="Decoração de festa com tema laboratório jurássico e balões em tons de verde e marrom" widths={[480, 720, 900]} sizes="(min-width: 768px) 400px, 92vw" class={img} data-reveal /></div>
        <div class="md:flex-[1.333]"><Image src={leao} alt="Decoração com arcos de balões coloridos, painel e troncos em tema safári" widths={[640, 960, 1100]} sizes="(min-width: 768px) 740px, 92vw" class={img} data-reveal /></div>
      </div>
      <div class="flex flex-col gap-3.5 md:flex-row md:gap-6">
        <div class="bg-orange rounded-card text-ink flex min-h-[220px] flex-col justify-between gap-8 p-7 md:flex-[1.333] md:p-9">
          <h3 class="max-w-[8em] text-[clamp(2.2rem,4vw,3.6rem)] leading-[1.05] font-semibold">Tem mais no Instagram.</h3>
          <a class="btn btn-sm btn-ghost self-start" href={site.instagram} target="_blank" rel="noopener"><Icon name="instagram-logo" />Ver Instagram</a>
        </div>
        <div class="md:flex-[0.75]"><Image src={arcoIris} alt="Decoração arco-íris com balões em tons pastel, painel em arco, mesas e lembrancinhas personalizadas" widths={[480, 720, 900]} sizes="(min-width: 768px) 400px, 92vw" class={img} data-reveal /></div>
      </div>
    </div>
  </div>
</section>
