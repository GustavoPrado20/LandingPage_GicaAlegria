---
import { Image } from 'astro:assets';
import QuoteButton from './QuoteButton.astro';
import logoArco from '../assets/img/logo-arco.png';
import logoNome from '../assets/img/logo-nome.png';

const links = [
  { href: '#servicos', label: 'Serviços' },
  { href: '#galeria', label: 'Galeria' },
  { href: '#regiao', label: 'Onde atendemos' },
  { href: '#duvidas', label: 'Dúvidas' },
];
---
<header class="flex h-[72px] items-center">
  <div class="wrap flex items-center justify-between">
    <a href="#topo" class="flex items-center gap-2.5 no-underline" aria-label="Gica Alegria, início">
      <Image src={logoArco} alt="" height={84} class="h-[34px] w-auto md:h-[42px]" loading="eager" />
      <Image src={logoNome} alt="Gica Alegria, festa infantil" height={76} class="h-7 w-auto md:h-[38px]" loading="eager" />
    </a>
    <div class="flex items-center gap-8 lg:gap-[34px]">
      <nav aria-label="Principal" class="hidden md:block">
        <ul class="flex gap-6 text-base font-semibold lg:gap-[34px]">
          {links.map((l) => (
            <li><a href={l.href} class="text-ink-soft hover:text-orange-deep no-underline">{l.label}</a></li>
          ))}
        </ul>
      </nav>
      <QuoteButton class="btn-sm" />
    </div>
  </div>
</header>
